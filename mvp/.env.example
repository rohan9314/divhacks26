# Around Me MVP. Copy to mvp/.env. Never commit real values.

# terminal = local development (no Photon needed); photon = live iMessage (all keys below required)
CHAT_PROVIDER=terminal

# Gemini: intent parsing, food ranking, reply writing. Without it: keyword parsing + template replies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Maps Platform (Places API (New) + Routes API). Not interchangeable with the Gemini key.
GOOGLE_MAPS_API_KEY=

# Tiger Postgres: nypd_complaints + city_events (repo sql/001-004), app.chat_context (mvp/sql/001).
DATABASE_URL=

# Photon Spectrum (https://app.photon.codes)
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# In group chats the agent answers only when mentioned: @agent
AGENT_NAME=agent
MESSAGE_BATCH_DELAY_MS=2000
LOG_LEVEL=info

# ---- Website accounts (moved from DeepSpace) ----
# Public hostname of this droplet's API, no scheme. Caddy gets its TLS certificate.
DOMAIN=api.plansaroundus.tech
# Random, 32+ characters: `openssl rand -hex 32`. Changing it invalidates pending sign-in codes.
SITE_AUTH_SECRET=
# Resend sends the sign-in code emails from a verified domain.
RESEND_API_KEY=
EMAIL_FROM=plansaroundus <noreply@plansaroundus.tech>
# Browser origins allowed to call /api (the Vercel site).
WEB_ALLOWED_ORIGINS=https://plansaroundus.tech,https://www.plansaroundus.tech
BETA_MAX_USERS=100
# Photon's shared pool gives each person their own @agent number. Fallback when that lookup fails.
AGENT_NUMBER=
PHOTON_LINE_TYPE=shared
